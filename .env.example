# ============================================================================
# 开发环境配置模板
# 复制为 .env 后使用；.env 已被 Git 忽略，不应提交任何真实密钥。
# ============================================================================

# 应用基础信息。
APP_ENV=development
APP_NAME=php-diagnostic-ragent
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# 只读代码仓库挂载根目录，本地直接运行时需改为宿主机绝对路径。
CODE_REPOSITORIES_ROOT=/repositories

# 本地 Docker Compose 中的待诊断项目目录；容器内固定映射为 /repositories/<项目名>。
# 当前默认值适用于本机 macOS，其他开发机可复制到 .env 后填写自己的绝对路径。
WAKY3_REPOSITORY_PATH=/Users/wskyygyso/work/www/waky3
WAKY4_REPOSITORY_PATH=/Users/wskyygyso/work/www/waky4
WAKY6_REPOSITORY_PATH=/Users/wskyygyso/work/www/waky6

# 验证接口 Redis 固定窗口限流：窗口内最大请求数和窗口秒数。
VALIDATION_RATE_LIMIT_PER_MINUTE=60
VALIDATION_RATE_LIMIT_WINDOW_SECONDS=60

# 诊断任务超时：软超时先写失败原因，硬超时由 Celery 终止 Worker 进程。
DIAGNOSIS_TASK_SOFT_TIME_LIMIT_SECONDS=240
DIAGNOSIS_TASK_TIME_LIMIT_SECONDS=300

# 文档索引任务超时：索引通常更慢，使用独立软/硬超时。
DOCUMENT_INDEX_SOFT_TIME_LIMIT_SECONDS=900
DOCUMENT_INDEX_TIME_LIMIT_SECONDS=960

# 历史数据保留天数，清理脚本默认只 dry-run，显式 --apply 才删除。
DIAGNOSTIC_TASK_RETENTION_DAYS=90
VALIDATION_AUDIT_RETENTION_DAYS=180
SECURITY_AUDIT_RETENTION_DAYS=180
DOCUMENT_INDEX_RETENTION_DAYS=90

# 开发环境默认关闭 API Key；生产环境必须启用。
AUTH_ENABLED=false

# API 写请求最大字节数，超限在认证和 JSON 解析前返回 413。
MAX_REQUEST_BODY_BYTES=1000000

# 逗号分隔的跨域来源白名单；留空表示不启用 CORS。
CORS_ALLOWED_ORIGINS=

# API Key JSON：键为至少 16 字符的密钥，值为调用方主体、项目白名单和 read/write scope。
# 示例值仅用于本地开发，禁止复制到生产环境。
API_KEYS_JSON={"replace-with-a-long-random-api-key":{"subject":"developer","projects":["waky3"],"scopes":["read","write"]}}

# LLM 诊断默认关闭；启用时需同时配置密钥和模型。
# auto 会根据 URL 选择 Responses API 或 OpenAI-compatible Chat Completions。
LLM_ENABLED=false
LLM_API_URL=https://api.openai.com/v1/responses
LLM_API_PROTOCOL=auto
LLM_API_KEY=
LLM_MODEL=

# 主模型失败后的备用模型，按逗号分隔从左到右尝试；主模型始终排在首位。
LLM_CANDIDATE_MODELS=

# 单任务最多模型请求数、同 Endpoint 模型连续失败熔断阈值和熔断持续时间。
# 超时乘以最大请求数必须低于诊断任务软超时，避免模型故障吞掉报告保存预算。
LLM_MAX_ATTEMPTS=2
LLM_CIRCUIT_FAILURE_THRESHOLD=3
LLM_CIRCUIT_OPEN_SECONDS=60

# 单次模型调用超时、最低证据数量和结果缓存策略。推理模型可能较慢，默认 90 秒；
# 该值仍应低于诊断任务软超时，确保模型失败后有时间保存确定性报告。
LLM_TIMEOUT_SECONDS=90
LLM_MIN_EVIDENCE_ITEMS=1
LLM_CACHE_ENABLED=true
LLM_CACHE_TTL_SECONDS=3600

# RAgent 自身使用的 Redis：健康检查、验证限流和 LLM 缓存。
REDIS_URL=redis://redis:6379/0

# RAgent 元数据库，仅保存任务、证据、反馈、索引和审计，不能作为目标业务库复用。
DATABASE_URL=postgresql://ragent:ragent@postgres:5432/ragent

# 目标业务库只读访问地址；留空时数据库验证返回“未配置”。
VALIDATION_DATABASE_URL=

# 项目符号索引跨任务缓存。同一代码快照并发诊断时只允许一个 Worker 扫描仓库，
# 其余任务等待共享结果；代码文件路径、大小或修改时间变化后自动使用新缓存键。
PROJECT_INDEX_CACHE_ENABLED=true
PROJECT_INDEX_CACHE_TTL_SECONDS=604800
PROJECT_INDEX_BUILD_LOCK_SECONDS=300
PROJECT_INDEX_WAIT_TIMEOUT_SECONDS=180

# Worker 实际并行执行槽。诊断任务包含大仓库扫描和证据关联，默认 2 个槽避免
# 过多进程互相争抢 I/O 后触发单任务软超时；索引 Worker 默认单槽执行。
DIAGNOSIS_WORKER_CONCURRENCY=2
INDEX_WORKER_CONCURRENCY=1

# Celery 任务队列和结果后端使用独立 Redis DB，避免与缓存键冲突。
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
