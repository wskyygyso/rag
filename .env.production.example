# ============================================================================
# 生产环境配置模板
# 所有尖括号占位值和空密钥必须由 Secret Manager 注入，仓库内禁止填写真实值。
# ============================================================================

# 生产启动门禁会校验这些关键开关；配置不合格时 API 拒绝启动。
APP_ENV=production
APP_NAME=php-diagnostic-ragent
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# 发布镜像必须使用 CI 生成的不可变 tag，或直接使用 registry@sha256 摘要。
RAGENT_IMAGE=registry.example.com/ragent@sha256:<IMMUTABLE_DIGEST>

# API 仅绑定本机地址，由受控 TLS 反向代理转发；仓库根目录只读挂载。
API_BIND_ADDRESS=127.0.0.1
API_PORT=8000
TRUSTED_PROXY_IPS=127.0.0.1
RAGENT_REPOSITORIES_ROOT=/srv/ragent/repositories
DIAGNOSIS_WORKER_CONCURRENCY=2
INDEX_WORKER_CONCURRENCY=1

# 生产代码仓库必须以只读卷挂载到此目录。
CODE_REPOSITORIES_ROOT=/repositories

# 验证接口 Redis 共享限流参数。
VALIDATION_RATE_LIMIT_PER_MINUTE=60
VALIDATION_RATE_LIMIT_WINDOW_SECONDS=60

# 诊断任务软/硬超时，软超时必须小于硬超时。
DIAGNOSIS_TASK_SOFT_TIME_LIMIT_SECONDS=240
DIAGNOSIS_TASK_TIME_LIMIT_SECONDS=300

# 文档索引任务软/硬超时，可在独立 index-worker 中调整并发。
DOCUMENT_INDEX_SOFT_TIME_LIMIT_SECONDS=900
DOCUMENT_INDEX_TIME_LIMIT_SECONDS=960

# 历史数据保留周期；生产必须由定时任务先 dry-run 再按审批执行 --apply。
DIAGNOSTIC_TASK_RETENTION_DAYS=90
VALIDATION_AUDIT_RETENTION_DAYS=180
SECURITY_AUDIT_RETENTION_DAYS=180
DOCUMENT_INDEX_RETENTION_DAYS=90

# 生产必须启用 API Key 认证。
AUTH_ENABLED=true

# 请求体大小限制和允许跨域的生产前端域名。
MAX_REQUEST_BODY_BYTES=1000000
CORS_ALLOWED_ORIGINS=https://ragent.example.com

# API Key JSON：在生产 Secret Manager 中生成随机密钥，项目与 scope 按最小权限配置。
API_KEYS_JSON={"<GENERATE_RANDOM_API_KEY>":{"subject":"production-client","projects":["waky3"],"scopes":["read","write"]}}

# LLM 默认关闭；开启前需评估模型数据策略、费用和输出质量。
# auto 支持 Responses API 与 OpenAI-compatible Base URL。
LLM_ENABLED=false
LLM_API_URL=https://api.openai.com/v1/responses
LLM_API_PROTOCOL=auto
LLM_API_KEY=
LLM_MODEL=

# 备用模型按逗号分隔；主模型始终第一顺位。超时乘以最大请求数必须低于任务软超时。
LLM_CANDIDATE_MODELS=
LLM_MAX_ATTEMPTS=2
LLM_CIRCUIT_FAILURE_THRESHOLD=3
LLM_CIRCUIT_OPEN_SECONDS=60

# LLM 超时、证据门槛和 Redis 缓存有效期。
LLM_TIMEOUT_SECONDS=30
LLM_MIN_EVIDENCE_ITEMS=1
LLM_CACHE_ENABLED=true
LLM_CACHE_TTL_SECONDS=3600

# 生产诊断必须启用真实语义向量；模型和密钥由 Secret Manager 注入。
# EMBEDDING_API_URL 留空时从 LLM_API_URL 派生，维度必须与供应商响应一致。
EMBEDDING_ENABLED=true
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=512
EMBEDDING_BATCH_SIZE=8
EMBEDDING_CONCURRENCY=2
EMBEDDING_MAX_RETRIES=3
EMBEDDING_TIMEOUT_SECONDS=60
EMBEDDING_SEND_DIMENSIONS=true

# 向量候选只用于源码发现；相似度门槛需用生产模型的中英文问题样本校准。
SEMANTIC_VECTOR_MIN_SIMILARITY=0.30
SEMANTIC_VECTOR_STRONG_SIMILARITY=0.40
SEMANTIC_VECTOR_CANDIDATE_LIMIT=40
SEMANTIC_VECTOR_SCAN_LIMIT=20000

# RAgent 自身 Redis，用于健康检查、验证限流和 LLM 缓存。
REDIS_URL=redis://redis:6379/0

# RAgent 元数据库连接；密码必须由 Secret Manager 注入。
DATABASE_URL=postgresql://ragent:<DATABASE_PASSWORD>@postgres:5432/ragent

# 目标业务库必须使用独立只读账号，不能复用 DATABASE_URL。
VALIDATION_DATABASE_URL=postgresql://readonly_user:<READONLY_PASSWORD>@target-db:5432/business

# Celery 队列和结果后端使用独立 Redis DB。
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
