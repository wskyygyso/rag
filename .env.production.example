# 复制为部署环境使用的 .env 后，将全部占位值替换为 Secret Manager 注入值。
APP_ENV=production
APP_NAME=php-diagnostic-ragent
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
CODE_REPOSITORIES_ROOT=/repositories

VALIDATION_RATE_LIMIT_PER_MINUTE=60
VALIDATION_RATE_LIMIT_WINDOW_SECONDS=60
DIAGNOSIS_TASK_SOFT_TIME_LIMIT_SECONDS=240
DIAGNOSIS_TASK_TIME_LIMIT_SECONDS=300
DOCUMENT_INDEX_SOFT_TIME_LIMIT_SECONDS=900
DOCUMENT_INDEX_TIME_LIMIT_SECONDS=960
DIAGNOSTIC_TASK_RETENTION_DAYS=90
VALIDATION_AUDIT_RETENTION_DAYS=180
SECURITY_AUDIT_RETENTION_DAYS=180
DOCUMENT_INDEX_RETENTION_DAYS=90

AUTH_ENABLED=true
MAX_REQUEST_BODY_BYTES=1000000
CORS_ALLOWED_ORIGINS=https://ragent.example.com
LLM_ENABLED=false
LLM_API_URL=https://api.openai.com/v1/responses
LLM_API_PROTOCOL=auto
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30
# 必须在 Secret Manager 中生成随机 API Key，不要提交真实值。
API_KEYS_JSON={"<GENERATE_RANDOM_API_KEY>":{"subject":"production-client","projects":["waky3"],"scopes":["read","write"]}}

REDIS_URL=redis://redis:6379/0
DATABASE_URL=postgresql://ragent:<DATABASE_PASSWORD>@postgres:5432/ragent
# 必须是不同的目标业务库和独立只读账号。
VALIDATION_DATABASE_URL=postgresql://readonly_user:<READONLY_PASSWORD>@target-db:5432/business

CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
